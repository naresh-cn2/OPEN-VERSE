# ==============================================================================
# OPEN-VERSE Environment Configuration Template
# ==============================================================================
# Copy this file to .env or set these environment variables in your deployment / CI.
# DO NOT COMMIT SENSITIVE VALUES OR PRIVATE KEYS TO VERSION CONTROL.

# --- Application Runtime ---
PORT=3125
NODE_ENV=development

# --- AI Provider API Keys (Optional, can also be configured in-app) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIzaSy...
# OPENROUTER_API_KEY=sk-or-...

# --- GitHub Releases & Distribution (CI / CD) ---
GITHUB_REPOSITORY=naresh-cn2/OPEN-VERSE
# GITHUB_TOKEN=ghp_...

# --- Desktop Tauri Code Signing (CI / CD only) ---
# TAURI_SIGNING_PRIVATE_KEY=dW50cnVzdGVkIGNvbW1lbnQ6...
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=...

# --- Web & Vercel Deployment (CI / CD only) ---
# VERCEL_TOKEN=...
# VERCEL_ORG_ID=...
# VERCEL_PROJECT_ID=...

