{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "OPEN-VERSE",
	"version": "0.2.0",
	"identifier": "ai.openverse.desktop",
	"build": {
		"beforeDevCommand": "bun run build:runtime && bun run dev:web",
		"devUrl": "http://localhost:3125",
		"beforeBuildCommand": "bun run dmg:background && bun run build",
		"frontendDist": "../webview/out"
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRENUJENEE1ODRBQ0QzQzMKUldURDA2eUVwZFJiVGJmWjduOFk4VTBnVTVLL2pDRWJLV3lySXlEeHlXRThZTEVCMGorQ0ZMTUcK",
			"endpoints": [
				"https://github.com/naresh-cn2/OPEN-VERSE/releases/download/desktop-latest/latest.json"
			]
		}
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "OPEN-VERSE",
				"width": 1500,
				"height": 980,
				"resizable": true,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "DeveloperTool",
		"shortDescription": "OPEN-VERSE AI coding assistant",
		"longDescription": "OPEN-VERSE is an autonomous AI coding assistant. It reads your code, edits files, runs commands, and works through tasks with you in any project on your machine.",
		"homepage": "https://open-verse-website.vercel.app",
		"externalBin": ["bin/cline-cli"],
		"resources": [
			"icons/app/*.png",
			"icons/app/macos/*.png",
			"bin/remote-helpers/*",
			"bin/desktop-backend/**/*"
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"nsis": {
				"installerHooks": "nsis/installer-hooks.nsh"
			}
		},
		"linux": {
			"deb": {
				"files": {
					"/usr/share/metainfo": "linux/metainfo/stable"
				}
			},
			"rpm": {
				"files": {
					"/usr/share/metainfo": "linux/metainfo/stable"
				}
			}
		},
		"macOS": {
			"entitlements": "entitlements.plist",
			"hardenedRuntime": true,
			"dmg": {
				"background": "dmg/background.gen.tiff",
				"windowSize": {
					"width": 640,
					"height": 432
				},
				"appPosition": {
					"x": 140,
					"y": 200
				},
				"applicationFolderPosition": {
					"x": 500,
					"y": 200
				}
			}
		}
	}
}
