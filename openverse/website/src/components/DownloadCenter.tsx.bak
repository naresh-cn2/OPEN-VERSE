import React, { useState, useEffect } from "react";
import {
  Monitor,
  Smartphone,
  Terminal,
  Check,
  Download,
  Apple,
  Info,
} from "lucide-react";

export const DownloadCenter: React.FC = () => {
  const [activeTab, setActiveTab] = useState<"windows" | "mac" | "linux" | "android">("windows");
  const [detectedOS, setDetectedOS] = useState<"windows" | "mac" | "linux" | "android" | null>(null);

  useEffect(() => {
    if (typeof window === "undefined") return;
    const handleHash = () => {
      const hash = window.location.hash.toLowerCase();
      if (hash.includes("windows")) setActiveTab("windows");
      else if (hash.includes("mac")) setActiveTab("mac");
      else if (hash.includes("linux")) setActiveTab("linux");
      else if (hash.includes("android") || hash.includes("termux")) setActiveTab("android");
    };
    handleHash();
    window.addEventListener("hashchange", handleHash);
    return () => window.removeEventListener("hashchange", handleHash);
  }, []);

  useEffect(() => {
    if (typeof window === "undefined") return;
    const ua = navigator.userAgent.toLowerCase();
    if (ua.includes("android")) setDetectedOS("android");
    else if (ua.includes("win")) setDetectedOS("windows");
    else if (ua.includes("mac")) setDetectedOS("mac");
    else if (ua.includes("linux")) setDetectedOS("linux");
  }, []);

  const GITHUB_RELEASES_ORG = "naresh-cn2/OPEN-VERSE";
  const RELEASE_TAG = "hermes-agent";

  const ASSETS = {
    windows: `https://github.com/${GITHUB_RELEASES_ORG}/releases/download/${RELEASE_TAG}/Hermes-Agent-2026.9.24-windows.zip`,
    mac: `https://github.com/${GITHUB_RELEASES_ORG}/releases/download/${RELEASE_TAG}/Hermes-Agent-2026.9.24-macos.zip`,
    linux: `https://github.com/${GITHUB_RELEASES_ORG}/releases/download/${RELEASE_TAG}/Hermes-Agent-2026.9.24-linux.zip`,
    android: `https://github.com/${GITHUB_RELEASES_ORG}/releases/download/${RELEASE_TAG}/Hermes-Agent-2026.9.24-android.zip`,
  };

  return (
    <section id="download" style={{ padding: "80px 0", position: "relative" }}>
      <div className="container">
        <div className="section-header">
          <div className="badge badge-purple">Open Verse • Hermes Agent</div>
          <h2 className="section-title">Download Hermes Agent</h2>
          <p className="section-subtitle">
            Open Verse ships Hermes Agent — the autonomous AI coding agent with persistent memory, skills, and messaging gateways. Runs natively on your device, isolated from the Store-installed Hermes.
          </p>
        </div>

        {/* Platform Selection Tabs */}
        <div
          style={{
            display: "flex",
            justifyContent: "center",
            gap: 8,
            marginBottom: 36,
            flexWrap: "wrap",
          }}
        >
          <button
            onClick={() => setActiveTab("windows")}
            className={`tab-btn ${activeTab === "windows" ? "active" : ""}`}
            style={{ display: "flex", alignItems: "center", gap: 8 }}
          >
            <Monitor size={16} />
            <span>Windows (10 / 11)</span>
            {detectedOS === "windows" && <Check size={13} style={{ color: "var(--emerald)" }} />}
          </button>
          <button
            onClick={() => setActiveTab("mac")}
            className={`tab-btn ${activeTab === "mac" ? "active" : ""}`}
            style={{ display: "flex", alignItems: "center", gap: 8 }}
          >
            <Apple size={16} />
            <span>macOS</span>
            {detectedOS === "mac" && <Check size={13} style={{ color: "var(--emerald)" }} />}
          </button>
          <button
            onClick={() => setActiveTab("linux")}
            className={`tab-btn ${activeTab === "linux" ? "active" : ""}`}
            style={{ display: "flex", alignItems: "center", gap: 8 }}
          >
            <Terminal size={16} />
            <span>Linux</span>
            {detectedOS === "linux" && <Check size={13} style={{ color: "var(--emerald)" }} />}
          </button>
          <button
            onClick={() => setActiveTab("android")}
            className={`tab-btn ${activeTab === "android" ? "active" : ""}`}
            style={{ display: "flex", alignItems: "center", gap: 8 }}
          >
            <Smartphone size={16} />
            <span>Android (Termux)</span>
            {detectedOS === "android" && <Check size={13} style={{ color: "var(--emerald)" }} />}
          </button>
        </div>

        {/* Tab 1: Windows */}
        {activeTab === "windows" && (
          <div className="glass-card" style={{ padding: 36, maxWidth: 960, margin: "0 auto" }} id="download-windows">
            {/* Header info */}
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", flexWrap: "wrap", gap: 16, marginBottom: 28 }}>
              <div>
                <div style={{ display: "flex", alignItems: "center", gap: 10, marginBottom: 6, flexWrap: "wrap" }}>
                  <h3 style={{ fontSize: "1.5rem", fontWeight: 700, color: "#ffffff" }}>Open Verse — Hermes Agent for Windows</h3>
                  <span
                    className="badge badge-purple"
                    style={{
                      display: "inline-flex",
                      alignItems: "center",
                      gap: 6,
                      background: "rgba(139, 92, 246, 0.12)",
                      color: "#c4b5fd",
                      borderColor: "rgba(139, 92, 246, 0.3)",
                    }}
                  >
                    <Monitor size={14} style={{ color: "#a78bfa" }} />
                    <span>Native Windows build</span>
                  </span>
                </div>
                <p style={{ color: "var(--text-secondary)", fontSize: "0.95rem", maxWidth: 640 }}>
                  Hermes Agent for Windows 10 and 11 — CLI, gateway, TUI, and tools all run natively. Isolated config at C:/Users/nares/.hermes-openverse; does not affect the Store-installed Hermes.
                </p>
              </div>

              <div style={{ fontSize: "0.85rem", color: "var(--text-muted)", display: "flex", alignItems: "center", gap: 8 }}>
                <span>Latest:</span>
                <span className="badge badge-green" style={{ fontSize: "0.75rem", padding: "2px 8px" }}>
                  Hermes Agent Stable
                </span>
              </div>
            </div>

            {/* Primary Download Options Grid */}
            <div
              style={{
                display: "grid",
                gridTemplateColumns: "repeat(auto-fit, minmax(300px, 1fr))",
                gap: 20,
                marginBottom: 28,
              }}
            >
              {/* Option 1: Setup Installer */}
              <div
                style={{
                  background: "#0c0c12",
                  borderRadius: 14,
                  padding: 24,
                  border: "1px solid var(--border-subtle)",
                  display: "flex",
                  flexDirection: "column",
                  justifyContent: "space-between",
                  gap: 16,
                  transition: "border-color 0.2s ease",
                }}
              >
                <div>
                  <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 8 }}>
                    <div style={{ display: "flex", alignItems: "center", gap: 8, color: "#ffffff", fontWeight: 700, fontSize: "1.05rem" }}>
                      <Monitor size={18} style={{ color: "var(--sky)" }} />
                      <span>Setup Installer (.exe)</span>
                    </div>
                    <span style={{ fontSize: "0.8rem", color: "var(--text-muted)", fontFamily: "var(--font-mono)" }}>
                      {FILE_META.windows.size}
                    </span>
                  </div>
                  <p style={{ fontSize: "0.86rem", color: "var(--text-secondary)", lineHeight: 1.5, margin: "0 0 12px 0" }}>
                    Standard Windows installer with Start Menu integration, desktop shortcuts, and automated background updates.
                  </p>
                </div>

                <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                  <a
                    href={ASSETS.windows}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="btn-primary"
                    style={{ padding: "12px 20px", fontSize: "0.95rem", justifyContent: "center", width: "100%", textDecoration: "none", display: "inline-flex", alignItems: "center", gap: 8 }}
                  >
                    <Download size={17} />
                    <span>Download Hermes Agent for Windows</span>
                  </a>
                </div>
              </div>

            {/* Launch Info */}
            <div style={{ display: "flex", flexDirection: "column", gap: 16 }}>
              <div>
                <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 8 }}>
                  <div style={{ display: "flex", alignItems: "center", gap: 8, color: "#ffffff", fontWeight: 700, fontSize: "1.05rem" }}>
                    <Download size={18} style={{ color: "var(--sky)" }} />
                    <span>Run Hermes Agent</span>
                  </div>
                  <span style={{ fontSize: "0.8rem", color: "var(--text-muted)", fontFamily: "var(--font-mono)" }}>From extracted ZIP</span>
                </div>
                <p style={{ fontSize: "0.86rem", color: "var(--text-secondary)", lineHeight: 1.5, margin: "0 0 12px 0" }}>
                  Extract the ZIP and double-click <code style={{ color: "var(--accent-light)" }}>scripts/hermes-openverse.bat</code>.
                </p>
              </div>
            </div>

            <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(220px, 1fr))", gap: 14, fontSize: "0.82rem", color: "var(--text-muted)" }}>
              <div>• OS: Windows 10 (1903+) or Windows 11</div>
              <div>• Architecture: 64-bit (x86_64)</div>
              <div>• Config: Isolated Hermes home</div>
              <div>• License: MIT (Hermes Agent)</div>
            </div>
          </div>
        )}

        {/* Tab 2: macOS */}
        {activeTab === "mac" && (
          <div className="glass-card" style={{ padding: 36, maxWidth: 960, margin: "0 auto" }} id="download-mac">
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", flexWrap: "wrap", gap: 16, marginBottom: 28 }}>
              <div>
                <div style={{ display: "flex", alignItems: "center", gap: 10, marginBottom: 6, flexWrap: "wrap" }}>
                  <h3 style={{ fontSize: "1.5rem", fontWeight: 700, color: "#ffffff" }}>Open Verse — Hermes Agent for macOS</h3>
                  <span
                    className="badge badge-purple"
                    style={{
                      display: "inline-flex",
                      alignItems: "center",
                      gap: 6,
                      background: "rgba(56, 189, 248, 0.12)",
                      color: "var(--sky)",
                      borderColor: "rgba(56, 189, 248, 0.3)",
                    }}
                  >
                    <Apple size={14} style={{ color: "var(--sky)" }} />
                    <span>Apple Silicon and Intel</span>
                  </span>
                </div>
                <p style={{ color: "var(--text-secondary)", fontSize: "0.95rem", maxWidth: 620 }}>
                  Hermes Agent for macOS — runs on Apple Silicon (M1-M4) and Intel x86_64.
                </p>
              </div>
              <div style={{ fontSize: "0.85rem", color: "var(--text-muted)", display: "flex", alignItems: "center", gap: 8 }}>
                <span>Latest:</span>
                <span className="badge badge-green" style={{ fontSize: "0.75rem", padding: "2px 8px" }}>
                  Hermes Agent Stable
                </span>
              </div>
            </div>

            <div style={{ display: "flex", gap: 12, flexWrap: "wrap" }}>
              <a
                href={ASSETS.mac}
                target="_blank"
                rel="noopener noreferrer"
                className="btn-primary"
                style={{ padding: "12px 26px", fontSize: "0.95rem", gap: 8 }}
              >
                <Download size={18} />
                <span>Download Hermes Agent for macOS</span>
              </a>
            </div>

            <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(220px, 1fr))", gap: 14, fontSize: "0.82rem", color: "var(--text-muted)" }}>
              <div>• Architecture: Apple Silicon (M1-M4) & Intel x86_64</div>
              <div>• OS: macOS 11.0+</div>
              <div>• Config: Isolated Hermes home</div>
              <div>• License: MIT (Hermes Agent)</div>
            </div>
          </div>
        )}

        {/* Tab 3: Linux */}
        {activeTab === "linux" && (
          <div className="glass-card" style={{ padding: 36, maxWidth: 960, margin: "0 auto" }} id="download-linux">
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", flexWrap: "wrap", gap: 16, marginBottom: 28 }}>
              <div>
                <div style={{ display: "flex", alignItems: "center", gap: 10, marginBottom: 6, flexWrap: "wrap" }}>
                  <h3 style={{ fontSize: "1.5rem", fontWeight: 700, color: "#ffffff" }}>Open Verse — Hermes Agent for Linux</h3>
                  <span className="badge badge-green" style={{ display: "inline-flex", alignItems: "center", gap: 6 }}>
                    <Check size={14} style={{ color: "var(--emerald)" }} />
                    <span>Native Linux build</span>
                  </span>
                </div>
                <p style={{ color: "var(--text-secondary)", fontSize: "0.95rem", maxWidth: 620 }}>
                  Hermes Agent for 64-bit Linux — Ubuntu, Debian, Fedora, RHEL, and derivatives.
                </p>
              </div>
              <div style={{ fontSize: "0.85rem", color: "var(--text-muted)", display: "flex", alignItems: "center", gap: 8 }}>
                <span>Latest:</span>
                <span className="badge badge-green" style={{ fontSize: "0.75rem", padding: "2px 8px" }}>
                  Hermes Agent Stable
                </span>
              </div>
            </div>

            <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(320px, 1fr))", gap: 16, marginBottom: 24 }}>
              <div style={{ background: "rgba(255, 255, 255, 0.03)", border: "1px solid var(--border-subtle)", borderRadius: 10, padding: "16px 18px" }}>
                <div style={{ fontSize: "0.9rem", fontWeight: 600, color: "#ffffff", marginBottom: 6, display: "flex", alignItems: "center", gap: 8 }}>
                  <Terminal size={16} style={{ color: "var(--sky)" }} />
                  <span>Hermes Agent for Linux (.zip)</span>
                </div>
                <div style={{ fontSize: "0.82rem", color: "var(--text-secondary)", marginBottom: 6 }}>
                  Size: ~107 MB
                </div>
                <div style={{ display: "flex", gap: 8 }}>
                  <a
                    href={ASSETS.linux}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="btn-secondary"
                    style={{ padding: "6px 12px", fontSize: "0.78rem", gap: 6 }}
                  >
                    <Download size={13} />
                    <span>Download for Linux</span>
                  </a>
                </div>
              </div>
            </div>

            <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(220px, 1fr))", gap: 14, fontSize: "0.82rem", color: "var(--text-muted)" }}>
              <div>• Requirements: glibc 2.31+</div>
              <div>• Architecture: x86_64</div>
              <div>• Config: Isolated Hermes home</div>
              <div>• License: MIT (Hermes Agent)</div>
            </div>
          </div>
        )}

        {/* Tab 4: Android (Termux) */}
        {activeTab === "android" && (
          <div className="glass-card" style={{ padding: 36, maxWidth: 960, margin: "0 auto" }} id="download-android">
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", flexWrap: "wrap", gap: 16, marginBottom: 28 }}>
              <div>
                <div style={{ display: "flex", alignItems: "center", gap: 10, marginBottom: 6, flexWrap: "wrap" }}>
                  <h3 style={{ fontSize: "1.5rem", fontWeight: 700, color: "#ffffff" }}>Open Verse — Hermes Agent for Android</h3>
                  <span
                    className="badge badge-green"
                    style={{
                      display: "inline-flex",
                      alignItems: "center",
                      gap: 6,
                      background: "rgba(var(--emerald), 0.12)",
                      color: "var(--emerald)",
                      borderColor: "rgba(var(--emerald), 0.3)",
                    }}
                  >
                    <Smartphone size={14} style={{ color: "var(--emerald)" }} />
                    <span>Termux (aarch64)</span>
                  </span>
                </div>
                <p style={{ color: "var(--text-secondary)", fontSize: "0.95rem", maxWidth: 640 }}>
                  Hermes Agent for Android via Termux — signed APT repository with Python, Node.js, and the TUI.
                </p>
              </div>
              <div style={{ fontSize: "0.85rem", color: "var(--text-muted)", display: "flex", alignItems: "center", gap: 8 }}>
                <span>Latest:</span>
                <span className="badge badge-green" style={{ fontSize: "0.75rem", padding: "2px 8px" }}>
                  Hermes Agent Stable
                </span>
              </div>
            </div>

            <div style={{ display: "flex", gap: 12, flexWrap: "wrap" }}>
              <a
                href={ASSETS.android}
                target="_blank"
                rel="noopener noreferrer"
                className="btn-primary"
                style={{ padding: "12px 20px", fontSize: "0.95rem", gap: 8 }}
              >
                <Download size={18} />
                <span>Download Hermes Agent for Android</span>
