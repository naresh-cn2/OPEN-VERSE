{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "bun install",
  "devCommand": "bun run dev",
  "regions": ["iad1"],
  "redirects": [
    {
      "source": "/api/download/windows",
      "destination": "https://github.com/naresh-cn2/OPEN-VERSE/releases/download/v3.0.0/OPEN-VERSE_3.0.0_x64-setup.exe",
      "permanent": false
    },
    {
      "source": "/api/download/windows-zip",
      "destination": "https://github.com/naresh-cn2/OPEN-VERSE/releases/download/v3.0.0/OPEN-VERSE_3.0.0_x64-windows.zip",
      "permanent": false
    },
    {
      "source": "/api/download/android",
      "destination": "/open-verse-mobile.apk",
      "permanent": false
    },
    {
      "source": "/api/download/android-apk",
      "destination": "https://github.com/naresh-cn2/OPEN-VERSE/releases/download/v3.0.0/open-verse-v3.0.0-android.apk",
      "permanent": false
    },
    {
      "source": "/api/download/android-zip",
      "destination": "https://github.com/naresh-cn2/OPEN-VERSE/releases/download/v3.0.0/open-verse-mobile-v3.0.0.zip",
      "permanent": false
    },
    {
      "source": "/api/download/mac",
      "destination": "https://github.com/naresh-cn2/OPEN-VERSE/releases/download/desktop-latest/OPEN-VERSE_0.2.0_aarch64.dmg",
      "permanent": false
    },
    {
      "source": "/api/download/linux-deb",
      "destination": "https://github.com/naresh-cn2/OPEN-VERSE/releases/download/desktop-latest/OPEN-VERSE_0.2.0_amd64.deb",
      "permanent": false
    },
    {
      "source": "/api/download/linux-rpm",
      "destination": "https://github.com/naresh-cn2/OPEN-VERSE/releases/download/desktop-latest/OPEN-VERSE-0.2.0-1.x86_64.rpm",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/authorize",
      "destination": "/api/auth/authorize"
    },
    {
      "source": "/api/auth/callback",
      "destination": "/api/auth/callback"
    },
    {
      "source": "/api/releases/latest",
      "destination": "/api/releases/latest"
    },
    {
      "source": "/api/devices/:path*",
      "destination": "/api/devices/:path*"
    },
    {
      "source": "/api/sync/:path*",
      "destination": "/api/sync/:path*"
    },
    {
      "source": "/((?!api/|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/open-verse-mobile.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"open-verse-mobile.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/distribution/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/yaml; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://open-verse-website.vercel.app; script-src 'self' 'unsafe-inline' https://accounts.google.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://accounts.google.com https://oauth2.googleapis.com https://api.github.com https://github.com https://release-assets.githubusercontent.com; frame-src 'self' https://accounts.google.com; object-src 'none'; base-uri 'self';"
        }
      ]
    }
  ]
}
